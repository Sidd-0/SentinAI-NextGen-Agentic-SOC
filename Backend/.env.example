# ==================== MAILTRAP SMTP CONFIGURATION ====================
# Get these credentials from your Mailtrap account:
# 1. Go to https://mailtrap.io/integrations/smtp
# 2. Select your project (e.g., "My Project")
# 3. Copy the SMTP credentials from the "Email Sending" section

# Sender email address (from your Mailtrap project)
SENDER_EMAIL=your-email@example.com

# Mailtrap SMTP host (typically inboxes.mailtrap.io)
SMTP_SERVER=smtp.mailtrap.io

# Mailtrap SMTP port (typically 2525 or 465 for TLS)
SMTP_PORT=2525

# Mailtrap username (from SMTP credentials)
SENDER_APP_PASSWORD=your-mailtrap-username

# Mailtrap password (from SMTP credentials)
# Note: This is your Mailtrap password, NOT a Gmail app password
SMTP_PASSWORD=your-mailtrap-password

# ==================== OPTIONAL: USE GMAIL INSTEAD ====================
# If using Gmail SMTP instead of Mailtrap, uncomment and configure:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@gmail.com
# SENDER_APP_PASSWORD=your-16-character-gmail-app-password

# ==================== GROQ API KEY ====================
GROQ_API_KEY=enter your groq api key here 
